# Cateringexpert (Pflicht)
PORTAL_BASE_URL=https://essen.cateringexpert.de
CATERINGEXPERT_EMAIL=
CATERINGEXPERT_PASSWORD=

# Ausführung
MODE=once
POLL_INTERVAL_MINUTES=120
# Anzahl kommender Bestellwochen ab nächster Woche (1–8)
WEEKS_AHEAD=3

# MQTT (in der HA-App automatisch erkannt)
MQTT_ENABLED=false
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_DISCOVERY_PREFIX=homeassistant
MQTT_BASE_TOPIC=cateringexpert
